// Test FlatBuffer schema for flatbed integration tests

attribute "paginated";

namespace test;

// Severity levels — exercises the enum codegen path. The first variant
// (`Info`) is the FlatBuffer default. The codegen re-exports `Severity`
// from `__fb` so callers can write `generated::test::Severity::Warning`
// without crossing the internal module boundary.
enum Severity : byte {
  Info,
  Warning,
  Error,
}

// Test request message
table TestRequest {
  message: string;
  value: uint64;
}

// Test response message
table TestResponse {
  message: string;
  value: uint64;
  success: bool;
}

// Nested table for testing nested struct support
table Address {
  street: string;
  city: string;
  zip_code: int32;
}

// User request with nested Address
table UserRequest {
  name: string;
  age: int32;
  address: Address;
}

// User response with nested Address
table UserResponse {
  user_id: uint64;
  name: string;
  address: Address;
  success: bool;
}

// Exercises the vector-of-tables codegen path: an addressbook holds a
// list of nested `Address` tables and zero or more user names. The wire
// format reads each Address as a WIPOffset; the high-level Rust struct
// surfaces it as `Option<Vec<Address>>`.
table AddressBook {
  owner: string;
  addresses: [Address];
  contact_names: [string];
}

// Exercises the enum codegen path: a `Severity` field lives alongside an
// `[Severity]` vector. Bare enum fields default to the first variant
// (`Severity::Info`) and round-trip through scalar accessors; vectors of
// enums go through `create_vector` / `iter().collect()` because flatc emits
// `Push + Copy` impls on the enum type.
table LogEvent {
  message: string;
  severity: Severity;
  history: [Severity];
}

// A value equal to its declared default is omitted on the wire, so a decoder
// must restore the declared default rather than the type's zero.
table Defaulted {
  count: int = 25;
  flag: bool = true;
  ratio: double = 1.5;
  level: Severity = Warning;
}

enum Traits : ulong (bit_flags) {
  Client,
  Money,
  NeedsDecision,
  Gmail,
}

table MailRef {
  account: string;
  message_id: string;
}

table FileRef {
  path: string;
}

union SourceRef { MailRef, FileRef }

table Ingest {
  title: string;
  ref: SourceRef;
  traits: Traits;
  default_traits: Traits = Money;
  history: [Traits];
}

table Page {
  next_page: string;
  previous_page: string;
}

enum ItemOrder : byte {
  Newest,
  Oldest,
}

enum ItemStatus : byte {
  Any = 0,
  Open,
  Closed,
}

table ListedItem {
  id: string;
  owner: string;
  created_at: long;
  status: ItemStatus;
}

table ListItemsRequest (paginated) {
  page: string;
  page_size: uint;
  owner: string;
  status: ItemStatus;
  order: ItemOrder;
}

table ListItemsResponse (paginated) {
  items: [ListedItem];
  page: Page;
  applied: ListItemsRequest;
}

// No paginated-request field, so it pairs with any paginated request.
table ListedItemsFeed (paginated) {
  items: [ListedItem];
  page: Page;
  total: uint;
}

root_type TestRequest;

// `ListItemsRequest`'s fields followed by one more, so each table decodes the
// other's bytes.
table ListItemsRequestV2 (paginated) {
  page: string;
  page_size: uint;
  owner: string;
  status: ItemStatus;
  order: ItemOrder;
  label: string;
}
