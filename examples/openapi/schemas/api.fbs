namespace api;

enum Priority : byte {
  Low,
  Medium,
  High,
}

table Tag {
  label: string;
}

table GreetRequest {
  name: string;
}

table GreetResponse {
  greeting: string;
}

table EchoRequest {
  message: string;
  times: uint32;
  priority: Priority;
  tags: [Tag];
}

table EchoResponse {
  message: string;
}

root_type GreetRequest;
